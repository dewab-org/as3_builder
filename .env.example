# Startup defaults for the BIG-IP and NetBox dialogs. Copy to .env and fill in.
# Served to the page at runtime by the dev/production server — never compiled
# into the bundle, so the published container image carries none of this.

BIGIP_HOSTNAME=
BIGIP_VALIDATE_CERTS=
BIGIP_USERNAME=
BIGIP_PASSWORD=

NETBOX_URL=
NETBOX_VALIDATE_CERTS=
# Either a token (v2 "nbt_key.secret" or a classic 40-character key) …
NETBOX_TOKEN=
# … or a username/password, which provisions a token on connect.
NETBOX_USERNAME=
NETBOX_PASSWORD=

# A deployed server withholds passwords and tokens from the page unless this
# is set; hostnames and usernames always prefill. Dev already exposes them.
# AS3B_EXPOSE_CREDENTIALS=1
