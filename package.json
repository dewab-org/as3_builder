{
  "name": "as3-builder",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "generate:docs": "node scripts/generate-as3-documentation.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/index.mjs",
    "precompress": "node scripts/precompress.mjs",
    "scan": "trivy fs --scanners vuln --severity CRITICAL,HIGH --ignore-unfixed . && trivy config --severity CRITICAL,HIGH,MEDIUM .",
    "scan:image": "docker build -q -t as3-builder:scan . && trivy image --scanners vuln,secret,misconfig --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 as3-builder:scan",
    "fetch:profiles": "node scripts/fetch-bigip-profiles.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
