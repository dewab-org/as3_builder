#!/bin/sh
# Enabled by `npm install` (see the "prepare" script) or manually with:
#   git config core.hooksPath .githooks
# Bypass a single commit with `git commit --no-verify`.
set -e

cd "$(git rev-parse --show-toplevel)"

staged_ts=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|mjs)$' || true)

echo "pre-commit: secrets"
node scripts/check-secrets.mjs
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
else
  echo "  (gitleaks not installed — pattern scan only)"
fi

# Trivy: dependency CVEs always (about a second), Dockerfile misconfiguration
# when the Dockerfile is touched. The image scan needs a full build, so it is
# opt-in here — run `npm run scan:image` (or set AS3B_SCAN_IMAGE=1) for that.
if command -v trivy >/dev/null 2>&1; then
  echo "pre-commit: scan"
  trivy fs --quiet --scanners vuln --severity CRITICAL,HIGH \
    --ignore-unfixed --exit-code 1 .

  if git diff --cached --name-only --diff-filter=ACMR | grep -q '^Dockerfile$'; then
    trivy config --quiet --severity CRITICAL,HIGH,MEDIUM --exit-code 1 .
  fi

  if [ "$AS3B_SCAN_IMAGE" = "1" ]; then
    echo "pre-commit: scan (image)"
    npm run --silent scan:image
  fi
else
  echo "pre-commit: scan skipped (trivy not installed)"
fi

if [ -n "$staged_ts" ]; then
  echo "pre-commit: lint"
  # Errors block the commit; warnings are printed and let through.
  # shellcheck disable=SC2086
  npx eslint $staged_ts

  echo "pre-commit: types"
  npx tsc -b

  echo "pre-commit: tests"
  npx vitest run --silent
fi
